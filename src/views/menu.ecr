<main class="menu-page">
  <header class="hero">
    <p class="eyebrow">A solitaire empire in thirteen turns</p>
    <h1>Micro Space Empire</h1>
    <p>Explore nearby stars, build a resilient economy, and survive two volatile years.</p>
    <a class="text-link" href="/rules">Read the rules</a>
  </header>

  <% if error %><div class="notice error" role="alert"><%= h(error) %></div><% end %>

  <section class="panel new-game">
    <div>
      <p class="eyebrow">Command</p>
      <h2>Start a new game</h2>
    </div>
    <form action="/games" method="post" class="new-game-form">
      <label>Save name
        <input name="name" maxlength="50" required placeholder="The Orion Campaign" autocomplete="off">
      </label>
      <label class="check-row">
        <input type="checkbox" name="expansion" value="true">
        <span><strong>Optional expansion</strong><small>Adds two systems and three events; each game uses a random subset.</small></span>
      </label>
      <button class="primary" type="submit">Begin campaign</button>
    </form>
  </section>

  <section class="save-library">
    <div class="section-heading">
      <div><p class="eyebrow">Archive</p><h2>Saved campaigns</h2></div>
      <span><%= saves.size %> save<%= saves.size == 1 ? "" : "s" %></span>
    </div>
    <% if saves.empty? %>
      <div class="empty-state">No campaigns yet. Name your empire and begin.</div>
    <% else %>
      <div class="save-grid">
        <% saves.each do |save| %>
          <article class="save-card">
            <div class="save-card-top">
              <span class="status <%= h(save.status) %>"><%= h(save.status.capitalize) %></span>
              <span><%= save.expansion ? "Expansion" : "Core" %></span>
            </div>
            <h3><%= h(save.name) %></h3>
            <p>Year <%= save.year %> · Turn <%= save.turn %><% if score = save.score %> · <strong><%= score %> VP</strong><% end %></p>
            <p class="muted">Autosaved <%= h(save.updated_at.gsub('T', ' ')[0, 16]) %> UTC</p>
            <div class="button-row">
              <a class="button primary" href="/games/<%= save.id %>"><%= save.status == "active" ? "Continue" : "View result" %></a>
              <form action="/games/<%= save.id %>/delete" method="post" data-confirm="Delete this save permanently?">
                <button class="danger ghost" type="submit">Delete</button>
              </form>
            </div>
          </article>
        <% end %>
      </div>
    <% end %>
  </section>
</main>
