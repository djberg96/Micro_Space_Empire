<main class="menu-page">
  <header class="compact-hero">
    <div>
      <p class="eyebrow">A solitaire empire in thirteen turns</p>
      <h1>Micro Space Empire</h1>
      <p>Explore, build, and survive two volatile years.</p>
    </div>
    <div class="header-controls">
      <label class="theme-picker">Theme
        <select data-theme-select aria-label="Color theme">
          <option value="starfield">Starfield</option><option value="nebula">Nebula</option><option value="tactical">Tactical Blue</option><option value="command">Command Deck</option>
        </select>
      </label>
      <a class="button ghost" href="/rules">Rules</a>
    </div>
  </header>

  <% if error %><div class="notice error" role="alert"><%= h(error) %></div><% end %>

  <section class="panel quick-start">
    <div>
      <p class="eyebrow">New campaign</p>
      <h2>Start playing</h2>
      <p class="muted">No name required. Save from the game menu if you want to keep it.</p>
    </div>
    <form action="/games" method="post" class="quick-start-form">
      <label class="check-row">
        <input type="checkbox" name="expansion" value="true">
        <span><strong>Optional expansion</strong><small>Two systems and three events; each game uses a random subset.</small></span>
      </label>
      <button class="primary" type="submit">New Game</button>
    </form>
  </section>

  <section class="save-library">
    <div class="section-heading">
      <div><p class="eyebrow">Continue</p><h2>Saved campaigns</h2></div>
      <span><%= saves.size %> save<%= saves.size == 1 ? "" : "s" %></span>
    </div>
    <% if saves.empty? %>
      <div class="empty-state">No saved campaigns.</div>
    <% else %>
      <div class="save-grid">
        <% saves.each do |save| %>
          <article class="save-card">
            <div class="save-card-top">
              <span class="status <%= h(save.status) %>"><%= h(save.status.capitalize) %></span>
              <span><%= save.expansion ? "Expansion" : "Core" %></span>
            </div>
            <h3><%= h(save.name) %></h3>
            <p>Year <%= save.year %> · Turn <%= save.turn %><% if score = save.score %> · <strong><%= score %> VP</strong><% end %></p>
            <p class="muted">Autosaved <%= h(save.updated_at.gsub('T', ' ')[0, 16]) %> UTC</p>
            <div class="button-row">
              <a class="button primary" href="/games/<%= save.id %>"><%= save.status == "active" ? "Continue" : "View result" %></a>
              <form action="/games/<%= save.id %>/delete" method="post" data-confirm="Delete this save permanently?">
                <button class="danger ghost" type="submit">Delete</button>
              </form>
            </div>
          </article>
        <% end %>
      </div>
    <% end %>
  </section>
</main>
